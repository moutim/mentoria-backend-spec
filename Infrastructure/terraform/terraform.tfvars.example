# ============================================
# Configuração de Exemplo - terraform.tfvars
# ============================================
# Copie este arquivo como terraform.tfvars e preencha com seus valores reais
# NUNCA commite arquivo terraform.tfvars no repositório (já está em .gitignore)

environment = "dev"

# Movimentos Database Configuration
movimentos_db_host     = "localhost"
movimentos_db_port     = "5432"
movimentos_db_name     = "movimentos"
movimentos_db_username = "postgres"
movimentos_db_password = "sua_senha_aqui"

# Movimentos Security Configuration
movimentos_jwt_secret = "sua_jwt_secret_muito_longa_e_segura_aqui"
movimentos_api_key    = "sua_api_key_segura_aqui"

# Movimentos Application Configuration
movimentos_log_level = "Information"

